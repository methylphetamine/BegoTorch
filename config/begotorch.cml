{
    // BegoTorch component manifest (begonia / Redmi Note 8 Pro, Fuchsia).
    //
    // WHY THIS FILE EXISTS
    // --------------------
    // This app writes the torch intensity to a privileged system node:
    //
    //     /sys/devices/platform/flashlights_mt6360/torchbrightness
    //
    // On Fuchsia, "root" access to a device is NOT obtained by running `su`
    // (Magisk / KernelSU / APatch are Android rooting tools and none of them
    // apply here). Privilege is *declared at build/flash time* in this manifest
    // and is fused into the Fuchsia package. When the TWRP-flashable zip below
    // is installed, BegoTorch already has every capability it needs:
    //
    //   - sandbox.filesystem  -> read/write the torch sysfs node (the write
    //                            that used to require `su`)
    //   - sandbox.devices     -> the input/display/touchstack the Flutter
    //                            embedding needs to draw and receive gestures
    //   - sandbox.storage     -> per-app SharedPreferences (icon choice, tile
    //                            state)
    //
    // Because the capability is baked into the installed package, users never
    // have to grant root, approve an `su` prompt, or touch Magisk/KernelSU.
    //
    // NOTE FOR THE DEVICE-SPECIFIC BUILD
    // ----------------------------------
    // The torch node path below (flashlights_mt6360) is the one the begonia
    // kernel exposes. If your begonia image names the driver/node differently,
    // change BOTH the filesystem path here AND kTorchDevice in lib/main.dart
    // to the exact node and rebuild. Everything else is standard Fuchsia
    // component-manifest syntax and needs no edits.
    "program": {
        "runner": "component"
    },
    "sandbox": {
        // Read/write access to the torch brightness node. This single grant
        // replaces the old runtime `su` invocation: once flashed, the app can
        // write the node directly and no root manager is involved. On Fuchsia
        // the sysfs node is an ordinary file, so type is "file".
        "filesystem": {
            "/sys/devices/platform/flashlights_mt6360": {
                "rights": ["Traverse", "Read"],
                "type": "directory"
            },
            "/sys/devices/platform/flashlights_mt6360/torchbrightness": {
                "rights": ["Read", "Write"],
                "type": "file"
            }
        },
        // What Flutter needs to put pixels on screen and to get touch input.
        "devices": [
            "graphics",
            "input",
            "sysmem"
        ],
        // Per-app persisted settings (chosen icon, tile state).
        "storage": "persistent"
    }
}